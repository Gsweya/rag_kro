# =========================================================
# rag_kro — environment configuration
# Copy to `.env` and adjust. NEVER commit `.env`.
# Reference: docs/DEPLOYMENT.md
# =========================================================

# ---- General --------------------------------------------
RAG_KRO_ENV=development
# Static admin token guarding the dashboard/API (no-auth mode).
ADMIN_TOKEN=change-me-rag-kro-admin-token
# Comma-separated API keys allowed to call internal services
INTERNAL_API_KEY=change-me-internal-key

# ---- Tenant auth boundary (no-auth mode) ------------------
# Every tenant-scoped API call must present X-Tenant-Id + X-Tenant-Key.
# The default tenant key below is seeded into `tenant_keys` at api startup.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
TENANT_DEFAULT_KEY=change-me-tenant-default-key
REQUIRE_TENANT_KEY=true
# Served to the browser for the dashboard (also sent by the gateways):
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_TENANT_KEY=change-me-tenant-default-key
# Gateways (override if a gateway is dedicated to a specific tenant):
WA_GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000001
WA_GATEWAY_TENANT_KEY=change-me-tenant-default-key
IG_GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000001
IG_GATEWAY_TENANT_KEY=change-me-tenant-default-key

# ---- Postgres -------------------------------------------
POSTGRES_DB=rag_kro
POSTGRES_USER=rag_kro
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag_kro:change-me-postgres@postgres:5432/rag_kro

# ---- Redis ----------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# Used both for remote queue + per-tenant chat state
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Qdrant ---------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_kro_vectors
# true = per-tenant Qdrant collection (hard isolation on top of payload filter).
#       Leaves = rag_kro_vectors__{tenant_id}. Flip on when 2nd real tenant goes live.
QDRANT_PER_TENANT_COLLECTIONS=false
# vector size for all-MiniLM-L6-v2
VECTOR_SIZE=384
# jaccard|cosine|dot — euclid
VECTOR_METRIC=cosine

# ---- MinIO (object storage for source files) -----------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=rag_kro_minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=rag-kro-documents

# ---- Embeddings -----------------------------------------
# local (sentence-transformers, $0) | hf (HF Inference API)
EMBEDDINGS_BACKEND=local
HF_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# optional for hf backend
HF_TOKEN=

# ---- LLM (default: HF Inference Providers, OpenAI-compatible router) ------
# openai_compatible (HF router, free tier) | hf (legacy serverless) | ollama
LLM_BACKEND=openai_compatible
HF_INFERENCE_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_URL=https://router.huggingface.co
HF_TOKEN=
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
# used when LLM_BACKEND=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=https://router.huggingface.co
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# ---- Ingestion pipeline (centralized, not per-user) ----
INGESTION_API_URL=http://ingestion:8001
INGEST_API_KEY=${INTERNAL_API_KEY}
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# re-embed a product/doc only if hash changed
ENABLE_HASH_CHECK=true
# hourly sweep interval (seconds)
SWEEP_INTERVAL=3600

# ---- RAG service ----------------------------------------
RAG_API_URL=http://rag:8002
RAG_API_KEY=${INTERNAL_API_KEY}
RETRIEVE_TOP_K=4
RAG_SYSTEM_PROMPT=You are a helpful sales assistant for a business. Answer using only the provided context. Cite products by name and price when relevant.

# ---- API orchestration ----------------------------------
API_PORT=8000
API_API_KEY=${INTERNAL_API_KEY}

# ---- WhatsApp gateway ------------------------------------
WA_GATEWAY_PORT=8100
WA_GATEWAY_INTERNAL_KEY=${INTERNAL_API_KEY}
WA_API_CALLBACK_URL=http://api:8000/webhook/message
# gmail/brevo SMTP (free tiers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Instagram gateway -----------------------------------
IG_GATEWAY_PORT=8200
IG_GATEWAY_INTERNAL_KEY=${INTERNAL_API_KEY}
IG_API_CALLBACK_URL=http://api:8000/webhook/message

# ---- Encryption (session creds at rest) ------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERENCE_SECRET_KEY=

# ---- Web (Next.js) ---------------------------------------
NEXT_PUBLIC_API_BASE=/api          # proxied via Next rewrite
WEB_PORT=3000